#!/data/data/com.termux/files/usr/bin/env bash
set -euo pipefail

if [[ $# -ne 1 ]]; then
  echo "Usage: ${0##*/} <file>"
  exit 1
fi

file="$1"

if [[ ! -f "$file" ]]; then
  echo "'$file' does not exist or is not a regular file" >&2
  exit 1
fi

case "$file" in
  *.tar* | *.tgz | *.tbz2 | *.txz) tar xf "$file" ;;
  *.zip) unzip "$file" ;;
  *.7z) 7z x "$file" ;;
  *.rar) unrar x "$file" ;;
  *.gz) gunzip "$file" ;;
  *.bz2) bunzip2 "$file" ;;
  *.xz) xz -d "$file" ;;
  *.pax) pax -r <"$file" ;;
  *.pax.Z) uncompress --stdout "$file" | pax -r ;;
  *.Z) uncompress "$file" ;;
  *)
    echo "Failed to extract '$file'" >&2
    exit 1
    ;;
esac
