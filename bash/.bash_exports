export PATH="$PATH:$HOME/.local/bin"

export LUA_PATH="./?.lua;./?/init.lua;$HOME/.local/share/lua/5.4/?.lua;$HOME/.local/share/lua/5.4/?/init.lua;;"
export LUA_CPATH="./?.so;$HOME/.local/lib/lua/5.4/?.so;;"
