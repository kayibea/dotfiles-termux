#!/usr/bin/env bash

export PATH="$PATH:$HOME/.local/bin"

export LUA_PATH="$HOME/.local/share/lua/5.4/?.lua;$HOME/.luarocks/share/lua/5.4/?.lua;;"
export LUA_CPATH="$HOME/.local/lib/lua/5.4/?.so;$HOME/.luarocks/lib/lua/5.4/?.so;;"

export PATH="$PATH:$(go env GOPATH)/bin"

export ANDROID_TMPDIR="/data/local/tmp/"
export EDITOR="hx"

export XDG_DATA_HOME="$HOME/.local/share"
export XDG_CACHE_HOME="$HOME/.cache"
export XDG_CONFIG_HOME="$HOME/.config"
