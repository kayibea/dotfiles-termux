alias ..='cd ..'
alias ...='cd ../..'

alias m='micro'
alias cls='clear'
alias zz='yazi'
alias lz='lazygit'

alias l='ls -CF'
alias la='ls -A'
alias ll='ls -alF'

alias llpg='gpg --list-key --keyid-format LONG'
alias reload='source ~/.bashrc && echo ".bashrc reloaded !"'

alias ealias='$EDITOR ~/dotfiles/bash/.bash_aliases'
alias eexport='$EDITOR ~/dotfiles/bash/.bash_exports'
