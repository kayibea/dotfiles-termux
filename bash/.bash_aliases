alias ..='cd ..'
alias ...='cd ../..'

alias gs='git status'

alias e='$EDITOR'
alias x='extract'
alias cl='clear'
alias lz='lazygit'

alias ls='ls --color=auto'
alias l='ls -CF'
alias l1='ls -1'
alias la='ls -A'
alias ll='ls -alF'

alias grep='grep --color=auto'
alias fgrep='fgrep --color=auto'
alias egrep='egrep --color=auto'

alias llpg='gpg --list-key --keyid-format LONG'

alias ealias='$EDITOR ~/dotfiles/bash/.bash_aliases'
alias eexport='$EDITOR ~/dotfiles/bash/.bash_exports'
