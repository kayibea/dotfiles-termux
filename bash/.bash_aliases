alias ..='cd ..'
alias ...='cd ../..'

alias gs='git status'

alias e='$EDITOR'
alias x='extract'
alias cl='clear'
alias lz='lazygit'

alias ls='ls --color=auto'
alias l='ls -CF'
alias la='ls -A'
alias l1='ls -1'
alias ll='ls -alF'

alias llpg='gpg --list-key --keyid-format LONG'

alias ealias='$EDITOR ~/dotfiles/bash/.bash_aliases'
alias eexport='$EDITOR ~/dotfiles/bash/.bash_exports'
